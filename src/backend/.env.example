# ============================================================
# SECURITY CONFIGURATION
# ============================================================

# Application Key (32 characters for AES-256)
APP_KEY=your_32_characters_secret_key_here

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# ============================================================
# REDIS CONFIGURATION
# ============================================================

# Redis dipakai untuk denylist JWT saat logout
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PREFIX=scapes:

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# Tipe database yang digunakan (mysql, pgsql, sqlite)
DB_CONNECTION=mysql

# Host / domain server database
DB_HOST=localhost

# Port database (default: mysql=3306, pgsql=5432)
DB_PORT=3306

# Nama database Scapes
DB_DATABASE=scapes

# Username untuk akses database
DB_USERNAME=root

# Password untuk akses database
DB_PASSWORD=

# Charset untuk koneksi database
DB_CHARSET=utf8mb4

# Collation untuk koneksi database
DB_COLLATION=utf8mb4_unicode_ci


# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# Environment aplikasi (development, staging, production)
APP_ENV=development

# Debug mode (true untuk development, false untuk production)
APP_DEBUG=true

# Timezone aplikasi
APP_TIMEZONE=Asia/Jakarta


# ============================================================
# SEEDER CONFIGURATION
# ============================================================

# Opsional: dipakai oleh composer run seed:admin / php seed_admin.php
ADMIN_SEED_EMAIL=admin@scapes.app
ADMIN_SEED_PASSWORD=admin12345


# ============================================================
# LOGGING CONFIGURATION
# ============================================================

# Level logging (debug, info, notice, warning, error, critical, alert, emergency)
LOG_LEVEL=debug
