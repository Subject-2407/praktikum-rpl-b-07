# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# Tipe database yang digunakan (mysql, pgsql, sqlite)
DB_CONNECTION=mysql

# Host / domain server database
DB_HOST=localhost

# Port database (default: mysql=3306, pgsql=5432)
DB_PORT=3306

# Nama database Scapes
DB_DATABASE=scapes

# Username untuk akses database
DB_USERNAME=root

# Password untuk akses database
DB_PASSWORD=

# Charset untuk koneksi database
DB_CHARSET=utf8mb4

# Collation untuk koneksi database
DB_COLLATION=utf8mb4_unicode_ci


# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# Environment aplikasi (development, staging, production)
APP_ENV=development

# Debug mode (true untuk development, false untuk production)
APP_DEBUG=true

# Timezone aplikasi
APP_TIMEZONE=Asia/Jakarta


# ============================================================
# LOGGING CONFIGURATION
# ============================================================

# Level logging (debug, info, notice, warning, error, critical, alert, emergency)
LOG_LEVEL=debug
