# ============================================================
# SECURITY CONFIGURATION
# ============================================================

# Application Key (32 characters for AES-256)
APP_KEY=your_32_characters_secret_key_here

# Application name
APP_NAME=Scapes

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# JWT access token TTL dalam menit
JWT_TTL_MINUTES=30

# ============================================================
# REDIS CONFIGURATION
# ============================================================

# Redis dipakai untuk denylist JWT saat logout
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PREFIX=scapes:

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# Tipe database yang digunakan (mysql, pgsql, sqlite)
DB_CONNECTION=mysql

# Host / domain server database
DB_HOST=localhost

# Port database (default: mysql=3306, pgsql=5432)
DB_PORT=3306

# Nama database Scapes
DB_DATABASE=scapes

# Username untuk akses database
DB_USERNAME=root

# Password untuk akses database
DB_PASSWORD=

# Charset untuk koneksi database
DB_CHARSET=utf8mb4

# Collation untuk koneksi database
DB_COLLATION=utf8mb4_unicode_ci


# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# Environment aplikasi (development, staging, production)
APP_ENV=development

# Debug mode (true untuk development, false untuk production)
APP_DEBUG=true

# Timezone aplikasi
APP_TIMEZONE=Asia/Jakarta


# ============================================================
# SMTP / EMAIL CONFIGURATION
# ============================================================

# URL frontend untuk tautan yang dikirim lewat email
FRONTEND_URL=http://localhost:4173

# Link action email untuk halaman frontend. Gunakan placeholder {token}.
# Halaman verifikasi harus meneruskan token ke POST /email-verifications.
# Halaman reset password harus mengirim password baru ke PUT /password-resets/{token}.
EMAIL_VERIFICATION_URL=http://localhost:4173/email-verifications?token={token}
PASSWORD_RESET_URL=http://localhost:4173/password-resets/{token}

# SMTP server
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=10
SMTP_HELO_DOMAIN=localhost

# Identitas pengirim email
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Scapes


# ============================================================
# SEEDER CONFIGURATION
# ============================================================

# Opsional: dipakai oleh composer run seed:admin / php seed_admin.php
ADMIN_SEED_EMAIL=admin@scapes.app
ADMIN_SEED_PASSWORD=admin12345


# ============================================================
# LOGGING CONFIGURATION
# ============================================================

# Level logging (debug, info, notice, warning, error, critical, alert, emergency)
LOG_LEVEL=debug
